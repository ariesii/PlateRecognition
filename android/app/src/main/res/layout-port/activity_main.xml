<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="@color/asphalt">
    <androidx.camera.view.PreviewView android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:implementationMode="compatible" />
    <com.example.platerecognition.camera.PlateOverlay android:id="@+id/overlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_margin="10dp"
        android:orientation="vertical" android:padding="10dp"
        android:background="@drawable/panel_surface">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="路況輔助  /  LIVE" android:textColor="@color/ivory"
            android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:textSize="21sp" />
        <TextView android:id="@+id/featureStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/initializing"
            android:textColor="@color/muted_blue" android:textSize="13sp" />
        <TextView android:id="@+id/warningBanner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="6dp" android:visibility="gone"
            android:textColor="@color/warning_amber" android:textSize="17sp"
            android:fontFamily="sans-serif-condensed" android:textStyle="bold"
            android:contentDescription="駕駛提示" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="#EA14232C" android:padding="12dp">
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/initializing"
            android:textColor="@color/ivory" android:textSize="15sp" android:maxLines="2" />
        <TextView android:id="@+id/distanceStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="距離 · 未校正" android:textColor="@color/road_cyan"
            android:fontFamily="monospace" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/pauseButton" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:text="暫停分析" android:textAllCaps="false" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/autoSaveSwitch"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:gravity="center_vertical" android:text="自動存照"
                android:textColor="@color/ivory" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/eventsButton" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:text="紀錄" android:textAllCaps="false" />
            <Button android:id="@+id/settingsButton" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:text="設定／校正" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/experimental" android:textSize="11sp"
            android:textColor="@color/muted_blue" android:gravity="end" />
    </LinearLayout>
</FrameLayout>
